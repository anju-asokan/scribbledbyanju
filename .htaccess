# Scribbled by Anju - Apache rewrite rules (GoDaddy hosting)

RewriteEngine On

# Force www + https
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^scribbledbyanju\.com$ [NC]
RewriteRule ^(.*)$ https://www.scribbledbyanju.com/$1 [L,R=301]

# Redirect requests for .html files to clean URL (no extension)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the clean URL by mapping it to the .html file internally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Custom 404 page
ErrorDocument 404 /404.html
